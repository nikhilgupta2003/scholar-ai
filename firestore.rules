rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: study_history
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required) - The UID of the owner
    //   - fileName: string (required) - Name of the uploaded file
    //   - mode: string (required) - 'quiz', 'notes', or 'points'
    //   - content: string (required) - The generated markdown content
    //   - createdAt: timestamp (required) - Creation time
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    function isValidStudyHistory(data) {
      return data.keys().hasAll(['userId', 'fileName', 'mode', 'content', 'createdAt']) &&
             data.userId is string && data.userId.size() > 0 &&
             data.fileName is string && data.fileName.size() > 0 && data.fileName.size() < 256 &&
             data.mode in ['quiz', 'notes', 'points'] &&
             data.content is string && data.content.size() > 0 && data.content.size() < 1048576 && // 1MB limit
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /study_history/{historyId} {
      // Users can only read their own history
      allow read: if isDocOwner();
      
      // Users can only create history for themselves
      allow create: if isAuthenticated() && 
                      request.resource.data.userId == request.auth.uid &&
                      isValidStudyHistory(request.resource.data);
      
      // Users can only delete their own history
      allow delete: if isDocOwner();
      
      // Updates are not allowed for history records
      allow update: if false;
    }

    match /user_progress/{progressId} {
      allow read: if isDocOwner();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isDocOwner() && request.resource.data.userId == resource.data.userId;
      allow delete: if isDocOwner();
    }
    
    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
